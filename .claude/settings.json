{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/pre-tool-use-contract-check.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/stop-contract-judge.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/stop-contract-keeper.js"
          }
        ]
      }
    ]
  }
}
